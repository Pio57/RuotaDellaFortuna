# Dominio del sito (sottodominio DuckDNS o nome del VPS Hostinger tipo srvXXXX.hstgr.cloud)
DOMAIN=nome.duckdns.org
# Rete Docker a cui è collegato Traefik (vedi comandi in docker-compose.yml)
TRAEFIK_NETWORK=n8n-8zow_default
# Nome del certresolver di Traefik (nel template Hostinger: mytlschallenge)
CERT_RESOLVER=mytlschallenge
